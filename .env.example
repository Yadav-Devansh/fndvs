# Server-only secrets. Never prefix these with VITE_ (that would ship them to the browser).
# Google Fact Check Tools API key — enables published fact-check lookups.
FACT_CHECK_API_KEY=
# News search uses GDELT DOC 2.0, which needs no key. If you switch to a keyed
# provider, add its key here, e.g. NEWS_API_KEY=
# Optional overrides for the AI gateway (defaults live in src/lib/evidence/gateway.server.ts).
AI_MODEL=
AI_GATEWAY_URL=
# Provided automatically by Lovable Cloud:
# LOVABLE_API_KEY=
# Browser-safe Lovable Cloud config (auto-generated):
# VITE_SUPABASE_URL= VITE_SUPABASE_PUBLISHABLE_KEY= VITE_SUPABASE_PROJECT_ID=
